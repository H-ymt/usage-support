{
	"name": "usage-support",
	"private": true,
	"packageManager": "pnpm@10.25.0",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check": "biome check --write .",
		"biome:check": "biome check .",
		"biome:fix": "biome check --write .",
		"biome:fix:unsafe": "biome check --write --unsafe .",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"prepare": "husky",
		"dev": "turbo dev",
		"dev:liff": "concurrently -n \"WEB,SERVER,NGROK\" -c \"cyan,magenta,yellow\" \"pnpm dev:web\" \"pnpm dev:server\" \"pnpm ngrok:start\"",
		"ngrok:start": "ngrok start --all --config ngrok.yml",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @usage-support/db db:push",
		"db:studio": "turbo -F @usage-support/db db:studio",
		"db:generate": "turbo -F @usage-support/db db:generate",
		"db:migrate": "turbo -F @usage-support/db db:migrate",
		"supabase:start": "supabase start",
		"supabase:stop": "supabase stop",
		"supabase:status": "supabase status",
		"supabase:reset": "supabase db reset",
		"supabase:types": "supabase gen types typescript --local > packages/db/src/supabase.types.ts"
	},
	"dependencies": {
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@cloudflare/workers-types": "catalog:",
		"@types/node": "catalog:",
		"concurrently": "^9.2.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"ngrok": "5.0.0-beta.2",
		"turbo": "^2.5.4",
		"typescript": "catalog:"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write ."
		]
	}
}
