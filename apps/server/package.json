{
	"name": "server",
	"main": "src/index.ts",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/server.ts",
		"dev:cloudflare": "wrangler dev",
		"deploy": "alchemy deploy",
		"destroy": "alchemy destroy"
	},
	"dependencies": {
		"@hono/node-server": "^1.19.7",
		"@hono/trpc-server": "^0.4.0",
		"@trpc/server": "catalog:",
		"@usage-support/api": "workspace:*",
		"@usage-support/auth": "workspace:*",
		"@usage-support/db": "workspace:*",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"hono": "catalog:",
		"tsx": "^4.21.0",
		"zod": "catalog:"
	},
	"trustedDependencies": [
		"supabase"
	],
	"devDependencies": {
		"@cloudflare/workers-types": "catalog:",
		"@types/node": "catalog:",
		"@usage-support/config": "workspace:*",
		"alchemy": "^0.81.1",
		"tsdown": "^0.16.5",
		"typescript": "catalog:",
		"wrangler": "^4.40.3"
	}
}
